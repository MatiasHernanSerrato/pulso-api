# Schema de pulso-api.
# Pulso trackea peso (salud) + plata (gastos) + alertas de anomalias.
# Empezamos por el modulo de peso.

scalar Time

# Directiva @auth: marca un field como protegido. El runtime se fija si hay
# un user id en el context y rechaza con error UNAUTHENTICATED si no.
# La aplicamos en mutations primero porque las queries publicas (ping)
# tienen sentido sin login.
directive @auth on FIELD_DEFINITION

"""
Weight representa una medicion de peso corporal en un momento dado.
El campo bodyFat es opcional porque no todas las balanzas lo miden.
"""
type Weight {
  id: ID!
  userId: ID!
  kg: Float!
  bodyFatPct: Float
  musclePct: Float
  measuredAt: Time!
  source: WeightSource!
  note: String
}

"""
De donde vino la medicion. BLE es balanza inteligente, MANUAL es carga a mano,
HEALTHKIT / HEALTH_CONNECT es sync desde el dispositivo.
"""
enum WeightSource {
  MANUAL
  BLE
  HEALTHKIT
  HEALTH_CONNECT
}

input WeightsFilter {
  from: Time
  to: Time
  limit: Int = 50
}

type Query {
  ping: String!
  weights(filter: WeightsFilter): [Weight!]! @auth
  weight(id: ID!): Weight @auth
}

"""
Input para crear una medicion a mano o desde balanza.
El userId no viaja aca, lo sacamos del token.
"""
input CreateWeightInput {
  kg: Float!
  bodyFatPct: Float
  musclePct: Float
  measuredAt: Time
  source: WeightSource = MANUAL
  note: String
}

type Mutation {
  createWeight(input: CreateWeightInput!): Weight! @auth
  deleteWeight(id: ID!): Boolean! @auth
}

# Schema de pulso-api.
# Pulso trackea peso (salud) + plata (gastos) + alertas de anomalias.
# Empezamos por el modulo de peso.

scalar Time

# Directiva @auth: marca un field como protegido. El runtime se fija si hay
# un user id en el context y rechaza con error UNAUTHENTICATED si no.
# La aplicamos en mutations primero porque las queries publicas (ping)
# tienen sentido sin login.
directive @auth on FIELD_DEFINITION

"""
Weight representa una medicion de peso corporal en un momento dado.
El campo bodyFat es opcional porque no todas las balanzas lo miden.
"""
type Weight {
  id: ID!
  userId: ID!
  kg: Float!
  bodyFatPct: Float
  musclePct: Float
  measuredAt: Time!
  source: WeightSource!
  note: String
}

"""
De donde vino la medicion. BLE es balanza inteligente, MANUAL es carga a mano,
HEALTHKIT / HEALTH_CONNECT es sync desde el dispositivo.
"""
enum WeightSource {
  MANUAL
  BLE
  HEALTHKIT
  HEALTH_CONNECT
}

input WeightsFilter {
  from: Time
  to: Time
  limit: Int = 50
}

# Modulo plata ------------------------------------------------------

"""
Category agrupa transactions. Puede ser una categoria global de Pulso
(cuando ownerId es null) o del user (ownerId == el user del token).
"""
type Category {
  id: ID!
  ownerId: ID
  name: String!
  kind: TransactionKind!
  icon: String
  color: String
  archived: Boolean!
}

"""
TransactionKind clasifica el signo del movimiento. Lo guardamos de forma
explicita para no inferirlo del signo del amount (asi un reintegro positivo
sigue siendo "income" aunque en algun momento alguien lo cargue en negativo).
"""
enum TransactionKind {
  EXPENSE
  INCOME
  TRANSFER
}

"""
Transaction es un movimiento de plata. amount se guarda en la moneda indicada,
nunca convertimos del lado del server. Pulso es multi-currency cliente.
"""
type Transaction {
  id: ID!
  userId: ID!
  categoryId: ID
  category: Category
  occurredAt: Time!
  amount: Float!
  currency: String!
  kind: TransactionKind!
  note: String
  externalSource: String
  externalRef: String
}

input TransactionsFilter {
  from: Time
  to: Time
  categoryId: ID
  limit: Int = 100
}

"""
Input para crear una transaction a mano o desde un webhook.
El userId lo sacamos del token.
Si categoryId es null se intenta inferir del texto del note, con fallback
a "Otros" del user.
"""
input CreateTransactionInput {
  categoryId: ID
  occurredAt: Time
  amount: Float!
  currency: String = "ARS"
  kind: TransactionKind!
  note: String
}

input CreateCategoryInput {
  name: String!
  kind: TransactionKind!
  icon: String
  color: String
}

input UpdateCategoryInput {
  id: ID!
  name: String
  icon: String
  color: String
}

type Query {
  ping: String!
  weights(filter: WeightsFilter): [Weight!]! @auth
  weight(id: ID!): Weight @auth

  categories(kind: TransactionKind): [Category!]! @auth
  transactions(filter: TransactionsFilter): [Transaction!]! @auth
  transaction(id: ID!): Transaction @auth
}

"""
Input para crear una medicion a mano o desde balanza.
El userId no viaja aca, lo sacamos del token.
"""
input CreateWeightInput {
  kg: Float!
  bodyFatPct: Float
  musclePct: Float
  measuredAt: Time
  source: WeightSource = MANUAL
  note: String
}

type Mutation {
  createWeight(input: CreateWeightInput!): Weight! @auth
  deleteWeight(id: ID!): Boolean! @auth

  createTransaction(input: CreateTransactionInput!): Transaction! @auth
  deleteTransaction(id: ID!): Boolean! @auth

  createCategory(input: CreateCategoryInput!): Category! @auth
  updateCategory(input: UpdateCategoryInput!): Category! @auth
  archiveCategory(id: ID!): Boolean! @auth
}
